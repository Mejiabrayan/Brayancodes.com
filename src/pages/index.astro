---
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import ShimmerBackground from "~/components/shimmer-background.tsx";
import HermesSend from "~/assets/hermessend.png";
import DevGenius from "~/assets/devgenius.png";
import RapidBart from "~/assets/rapidbart.png";
import BentoGrid from "~/components/bento-grid.tsx";
import Avatar from "~/assets/profile.jpg";
---

<Layout title="Brayan M. Cuenca | Full-Stack Web Developer">
    <ShimmerBackground client:load />

  <section
    class="mb-4 flex min-h-[calc(80vh-4rem)] flex-col justify-center rounded-2xl bg-transparent p-2 md:p-3"
    transition:name="fade"
    aria-labelledby="hero-heading"
  >
    <div class="space-y-6 text-center sm:space-y-8">
      <header class="space-y-4 flex flex-col items-center">
        <Image
          src={Avatar}
          alt="A photo of Brayan Mejia Cuenca"
          class="w-24 h-24 rounded-full shadow-lg object-cover"
        />
        <h1
          id="hero-heading"
          class="font-[Tobias] text-2xl text-neutral-600 md:text-xl lg:text-4xl"
        >
          Brayan Mejia Cuenca
        </h1>

        <p
          class="max-w-sm text-base leading-relaxed text-neutral-400 sm:max-w-2xl sm:text-lg lg:max-w-3xl lg:text-xl"
        >
          Self-taught software engineer based in the San Francisco Bay Area.
          Currently working at the intersection of AI, security, UI design, and
          advancing my skills in web development.
        </p>
      </header>
      <nav
        class="text-primary flex items-center justify-center gap-6"
        aria-label="Social media links"
      >
        <a
          href="https://github.com/Mejiabrayan"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 transition-colors duration-200 hover:bg-neutral-800/50 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black focus:outline-none"
          aria-label="Visit Brayan Mejia Cuenca on GitHub (opens in new tab)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-github"
            role="img"
            aria-labelledby="github-title"
            aria-hidden="true"
          >
            <title id="github-title">GitHub</title>
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/brayan-mejia"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 transition-colors duration-200 hover:bg-neutral-800/50 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black focus:outline-none"
          aria-label="Visit Brayan Mejia Cuenca on LinkedIn (opens in new tab)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-linkedin"
            role="img"
            aria-labelledby="linkedin-title"
            aria-hidden="true"
          >
            <title id="linkedin-title">LinkedIn</title>
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a
          href="https://x.com/BrayanCodes"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 transition-colors duration-200 hover:bg-neutral-800/50 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black focus:outline-none"
          aria-label="Visit Brayan Mejia Cuenca on X (Twitter) (opens in new tab)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-x"
            role="img"
            aria-labelledby="x-title"
            aria-hidden="true"
          >
            <title id="x-title">X (Twitter)</title>
            <path
              d="M3 21L10.5484 13.4516M21 3L13.4516 10.5484M13.4516 10.5484L8 3H3L10.5484 13.4516M13.4516 10.5484L21 21H16L10.5484 13.4516"
            ></path>
          </svg>
        </a>
      </nav>
    </div>
  </section>

  <section
    class="mb-2 flex h-full w-full flex-col items-center justify-center relative"
  >
    <!-- Section Header -->
    <div class="mb-8 px-4 text-center">
      <h2
        class="mb-3 font-[Tobias] text-2xl text-neutral-600 sm:text-3xl lg:text-4xl"
      >
        Featured Projects
      </h2>
      <p class="mx-auto max-w-2xl text-sm text-neutral-400 sm:text-base">
        A collection of my recent work spanning AI, web development, and
        innovative solutions
      </p>
    </div>

    <BentoGrid client:load />
  </section>
</Layout>
