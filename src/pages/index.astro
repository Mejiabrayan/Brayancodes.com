---
import Layout from "~/layouts/Layout.astro";
import ShimmerBackground from "~/components/shimmer-background.tsx";
import { Image } from "astro:assets";
import HermesSend from "~/assets/hermessend.png";
import DevGenius from "~/assets/devgenius.png";
import RapidBart from "~/assets/rapidbart.png";
---

<Layout title="Brayan M. Cuenca | Full-Stack Web Developer">
  <div class="fixed inset-0 -z-10" role="presentation" aria-hidden="true">
    <ShimmerBackground client:load />
  </div>

  <section
    class="flex min-h-[calc(80vh-4rem)] flex-col justify-center p-2 md:p-3"
    transition:name="fade"
    aria-labelledby="hero-heading"
  >
    <div class="space-y-6 sm:space-y-8">
      <header class="space-y-4 bg-transparent backdrop-blur-2xl">
        <h1
          id="hero-heading"
          class="font-[Tobias] text-lg text-neutral-400 text-shadow-md sm:text-xl lg:text-2xl"
        >
          Brayan Mejia Cuenca
        </h1>

        <p
          class="max-w-sm text-base leading-relaxed text-neutral-300 text-shadow-lg sm:max-w-2xl sm:text-lg lg:max-w-3xl lg:text-xl"
        >
          Self-taught software engineer based in the San Francisco Bay Area.
          Currently working at the intersection of AI, security, UI design, and
          advancing my skills in web development.
        </p>
      </header>

      <nav
        class="text-primary flex items-center gap-6"
        aria-label="Social media links"
      >
        <a
          href="https://github.com/Mejiabrayan"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 transition-colors duration-200 hover:bg-neutral-800/50 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black focus:outline-none"
          aria-label="Visit Brayan Mejia Cuenca on GitHub (opens in new tab)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-github"
            role="img"
            aria-labelledby="github-title"
            aria-hidden="true"
          >
            <title id="github-title">GitHub</title>
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/brayan-mejia"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 transition-colors duration-200 hover:bg-neutral-800/50 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black focus:outline-none"
          aria-label="Visit Brayan Mejia Cuenca on LinkedIn (opens in new tab)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-linkedin"
            role="img"
            aria-labelledby="linkedin-title"
            aria-hidden="true"
          >
            <title id="linkedin-title">LinkedIn</title>
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a
          href="https://x.com/BrayanCodes"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 transition-colors duration-200 hover:bg-neutral-800/50 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black focus:outline-none"
          aria-label="Visit Brayan Mejia Cuenca on X (Twitter) (opens in new tab)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-x"
            role="img"
            aria-labelledby="x-title"
            aria-hidden="true"
          >
            <title id="x-title">X (Twitter)</title>
            <path
              d="M3 21L10.5484 13.4516M21 3L13.4516 10.5484M13.4516 10.5484L8 3H3L10.5484 13.4516M13.4516 10.5484L21 21H16L10.5484 13.4516"
            ></path>
          </svg>
        </a>
      </nav>
    </div>
  </section>
  <section
    class="mb-2 flex h-full w-full flex-col items-center justify-center rounded-2xl"
  >
    <div
      class="grid w-full max-w-[1328px] grid-flow-dense grid-cols-12 gap-4 rounded-2xl p-2 ring ring-white/10 xl:auto-rows-fr"
    >
      <section
        class="@container/section col-span-full flex flex-col gap-2 rounded-2xl bg-transparent p-2 ring ring-white/10 backdrop-blur-2xl md:col-span-6 xl:row-span-4"
      >
        <div class="flex flex-1 flex-col gap-4 p-6">
          <h3
            class="flex flex-col gap-4 font-semibold @[17.5rem]:flex-row @[17.5rem]:items-center"
          >
            DevGenius
          </h3>
          <p class="max-w-prose text-white">
            DevGenius Creates SEO-optimized technical content and publish to
            Dev.to in minutes.
          </p>
        </div>
        <div
          class="flex aspect-[100/66] items-end justify-center overflow-hidden rounded-md p-0 ring ring-white/10 md:aspect-square xl:aspect-[640/376]"
        >
          <Image
            src={DevGenius}
            alt="Dev Genius"
            class="h-full w-full object-none object-[center_1rem]"
            width={468}
            height={376}
            quality={95}
            format="webp"
            densities={[1, 2]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
            placeholder="blur"
          />
        </div>
      </section>
      <section
        class="@container/section col-span-full flex flex-col gap-2 rounded-2xl bg-transparent p-2 ring ring-white/10 backdrop-blur-2xl md:col-span-6 xl:row-span-4"
      >
        <div class="flex flex-1 flex-col gap-4 p-6">
          <h3
            class="flex flex-col gap-4 font-semibold @[17.5rem]:flex-row @[17.5rem]:items-center"
          >
            Hermes Send
          </h3>
          <p class="max-w-prose text-white">
            I've worked on a variety of projects, from small personal projects
            to large-scale enterprise applications.
          </p>
        </div>
        <div
          class="flex aspect-[100/66] items-end justify-center overflow-hidden rounded-md p-0 ring ring-white/10 md:aspect-square xl:aspect-[640/376]"
        >
          <Image
            src={HermesSend}
            alt="Hermes Send"
            class="h-full w-full object-none object-[center_1rem]"
            width={468}
            height={376}
            quality={95}
            format="webp"
            densities={[1, 2]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
            placeholder="blur"
          />
        </div>
      </section>
    </div>
  </section>
  <section
    class="@container/section col-span-full flex flex-col gap-2 rounded-2xl ring ring-white/10 md:col-span-6 xl:row-span-4"
  >
    <div class="flex flex-1 flex-col gap-4 p-6">
      <h3
        class="flex flex-col gap-4 font-semibold @[17.5rem]:flex-row @[17.5rem]:items-center"
      >
        <p class="max-w-prose text-white">
          I've worked on a variety of projects, from small personal projects to
          large-scale enterprise applications.
        </p>
      </h3>
      <div class="flex flex-col gap-4"></div>
    </div>
  </section>
</Layout>
